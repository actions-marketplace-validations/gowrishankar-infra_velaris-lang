// Talking to the web, without the plumbing.
//
// import "http.vel" as http
// check http.get(url) { ok body { ... } fail why { ... } }

fn get(url: Text) -> Text uses net or fail {
    return try fetch(url)
}

fn status(url: Text) -> Int uses net or fail
ensures result >= 0
{
    let code = try fetch_status(url)
    if code < 0 {
        fail "that is not a status"
    }
    return code
}

fn ok(url: Text) -> Bool uses net or fail {
    let code = try status(url)
    return code >= 200 and code < 300
}

fn send(url: Text, body: Text) -> Text uses net or fail {
    return try post(url, body)
}

fn get_json(url: Text, path: Text) -> Text uses net or fail {
    let body = try fetch(url)
    return try json_get(body, path)
}

fn call(method: Text, url: Text, body: Text, headers: Text) -> Text
uses net or fail
{
    return try request(method, url, body, headers)
}

fn body_of(answer: Text) -> Text or fail {
    return try json_get(answer, "body")
}

fn code_of(answer: Text) -> Int or fail {
    return try json_int(answer, "status")
}

fn header_of(answer: Text, name: Text) -> Text or fail {
    return try json_get(answer, format("headers.{}", name))
}

fn get_with(url: Text, headers: Text) -> Text uses net or fail {
    let answer = try request("GET", url, "", headers)
    return try json_get(answer, "body")
}

fn post_json(url: Text, body: Text) -> Text uses net or fail {
    let headers = "{\"Content-Type\": \"application/json\"}"
    let answer = try request("POST", url, body, headers)
    return try json_get(answer, "body")
}
