// v0.11: fetch is REAL - this program performs an actual HTTP GET.
// It needs an internet connection, so it is NOT part of run_tests.py.
// The point of Velaris: this power is VISIBLE. 'uses net' is right
// there in the signature - and a function without it can never do this.

fn homepage(url: Text) -> Text uses net {
    return fetch(url)
}

fn main() uses io, net {
    let body = homepage("https://raw.githubusercontent.com/octocat/Hello-World/master/README")
    print("fetched " + length(body) + " characters:")
    print(body)
}
