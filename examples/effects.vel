// The effect system showcase: four effects, each declared honestly.
// (Network gets its own showcase in net.vel - it needs a connection.)

fn dice() -> Int uses rand {
    return random(6) + 1
}

fn timestamp() -> Int uses clock {
    return now()
}

fn save_report(text: Text) uses fs {
    write_file("report.txt", text)
}

fn main() uses io, fs, clock, rand {
    print("dice roll: " + dice())
    print("time now: " + timestamp())
    save_report("all systems working")
    print("saved report.txt with: " + read_file("report.txt"))
}
