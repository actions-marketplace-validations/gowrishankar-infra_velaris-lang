// v0.13: the prover learned lists, via Z3's theory of arrays.
// Promises ABOUT LISTS - lengths, elements, growth - are now proven
// before the program runs.

fn head(xs: List of Int) -> Int
    requires length(xs) > 0
    ensures result == get(xs, 0)
{
    return get(xs, 0)
}

fn grow(xs: List of Int, v: Int) -> List of Int
    ensures length(result) == length(xs) + 1
    ensures get(result, length(xs)) == v
{
    return push(xs, v)
}

fn main() uses io {
    let xs = [10, 20, 30]
    print("head: " + head(xs))
    let ys = grow(xs, 40)
    print("grown to " + length(ys) + " items, new last: " + get(ys, 3))
}
