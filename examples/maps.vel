// v1.4: maps - lookup tables. Keys are Text or Int; get/has/put/keys.
// put returns a NEW map (immutable, like push for lists).

fn main() uses io {
    let ages = {"alice": 30, "bob": 25}
    print(ages)
    print("alice is " + get(ages, "alice"))
    print("has carol? " + has(ages, "carol"))
    let ages2 = put(ages, "carol", 41)
    print("now " + length(ages2) + " people")
    let names = keys(ages2)
    let i = 0
    while i < length(names) {
        let n = get(names, i)
        print(n + " -> " + get(ages2, n))
        i = i + 1
    }
}
