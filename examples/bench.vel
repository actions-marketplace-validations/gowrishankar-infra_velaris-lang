// v0.9 benchmark: heavy pure math.
// fib is the classic recursion torture test; burn is a hot loop.
// Both are pure Int functions -> compiled to machine code via LLVM.
// Run:      python velaris.py bench.vel --time
// Compare:  python velaris.py bench.vel --time --no-native

fn fib(n: Int) -> Int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn burn(n: Int) -> Int {
    let total = 0
    let i = 0
    while i < n {
        total = total + i * i - i
        i = i + 1
    }
    return total
}

fn main() uses io {
    print("fib(27) = " + fib(27))
    print("burn(1000000) = " + burn(1000000))
}
