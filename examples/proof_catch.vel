// The nightmare bug: wrong ONLY when years > 30. Every normal test
// (new hires, 5 years, 20 years...) passes. It would ship.
// Z3 searches ALL allowed inputs and finds the exact one that breaks
// the promise - without running the program.

fn pay_bonus(salary: Int, years: Int) -> Int
    requires salary >= 0
    requires years >= 0
    ensures result >= salary
{
    if years > 30 {
        return salary - 1000
    }
    return salary + years * 100
}

fn main() uses io {
    print(pay_bonus(50000, 5))
}
