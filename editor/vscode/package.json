{
  "name": "velaris-syntax",
  "displayName": "Velaris",
  "description": "Syntax highlighting for the Velaris programming language (.vel)",
  "version": "1.1.0",
  "publisher": "velaris-lang",
  "engines": { "vscode": "^1.50.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "velaris",
      "aliases": ["Velaris", "velaris"],
      "extensions": [".vel"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "velaris",
      "scopeName": "source.velaris",
      "path": "./syntaxes/velaris.tmLanguage.json"
    }]
  }
}
