{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Velaris",
  "scopeName": "source.velaris",
  "patterns": [
    { "name": "comment.line.double-slash.velaris", "match": "//.*$" },
    { "name": "string.quoted.double.velaris",
      "begin": "\"", "end": "\"",
      "patterns": [{ "name": "constant.character.escape.velaris", "match": "\\\\[nt\"\\\\]" }] },
    { "name": "keyword.control.velaris",
      "match": "\\b(if|else|while|return|import)\\b" },
    { "name": "keyword.declaration.velaris",
      "match": "\\b(fn|let|record)\\b" },
    { "name": "keyword.other.contract.velaris",
      "match": "\\b(requires|ensures|invariant|uses)\\b" },
    { "name": "keyword.operator.logical.velaris",
      "match": "\\b(and|or|not)\\b" },
    { "name": "constant.language.velaris",
      "match": "\\b(true|false|result)\\b" },
    { "name": "support.type.velaris",
      "match": "\\b(Int|Text|Bool|List|of)\\b" },
    { "name": "support.function.builtin.velaris",
      "match": "\\b(print|ask|read_file|write_file|fetch|now|random|length|push|get|to_int|to_text|contains|split|upper|lower)\\b(?=\\s*\\()" },
    { "name": "entity.name.function.velaris",
      "match": "(?<=\\bfn\\s)[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "entity.name.type.record.velaris",
      "match": "(?<=\\brecord\\s)[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "constant.numeric.velaris", "match": "\\b[0-9]+\\b" },
    { "name": "keyword.operator.velaris",
      "match": "==|!=|<=|>=|->|[+\\-*/%<>=]" }
  ]
}
